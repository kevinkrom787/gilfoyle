# --- Slack (Bolt, Socket Mode) ---
# Bot token, starts with xoxb- (OAuth & Permissions page)
SLACK_BOT_TOKEN=xoxb-...
# Signing secret (Basic Information page)
SLACK_SIGNING_SECRET=...
# App-level token, starts with xapp-, needs the connections:write scope (Basic Information -> App-Level Tokens)
SLACK_APP_TOKEN=xapp-...

# --- Anthropic ---
# Used by the Mastra "gilfoyle" agent via @ai-sdk/anthropic
ANTHROPIC_API_KEY=sk-ant-...

# --- AWS ---
# Standard AWS credential env vars (or rely on a configured profile / IAM role).
# gilfoyle's CDK provisioner shells out to the `cdk` CLI, which uses the
# default AWS credential provider chain.
AWS_REGION=us-east-1
# AWS_PROFILE=gilfoyle

# --- gilfoyle platform ---
# Name of the DynamoDB table created by GilfoylePlatformStack (see README).
GILFOYLE_REGISTRY_TABLE=gilfoyle-environments
# Directory gilfoyle uses to run `cdk deploy` / `cdk destroy` from.
GILFOYLE_CDK_APP_DIR=./src/cdk
# Local sqlite file used for Mastra conversation memory (per-thread context).
GILFOYLE_MEMORY_DB_PATH=./.gilfoyle-memory.db
